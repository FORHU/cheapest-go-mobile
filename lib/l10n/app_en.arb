  "legal_content_cookie_duration_title": "Cookie Duration",
  "legal_content_cookie_managing_intro": "You can control cookies in several ways:",
  "legal_content_cookie_managing_note": "Adjusting your cookie settings may affect the functionality of the Platform. Essential cookies cannot be disabled without impacting your ability to use CheapestGo.",
  "legal_content_cookie_managing_title": "Managing Your Cookie Preferences",
  "legal_content_cookie_thirdParty_intro": "Some cookies are set by third-party services that appear on our pages:",
