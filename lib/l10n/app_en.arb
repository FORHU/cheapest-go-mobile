  "legal_content_cookie_contact_intro": "For questions about our use of cookies:",
  "legal_content_cookie_contact_title": "Contact",
  "legal_content_cookie_doNotTrack_body": "Some browsers send a \"Do Not Track\" (DNT) signal. CheapestGo does not currently respond to DNT signals, as there is no universal standard for how websites should react to them. We continue to evaluate this area as standards evolve.",
  "legal_content_cookie_doNotTrack_title": "Do Not Track",
