# Copy to .env (git-ignored) and run: flutter run --dart-define-from-file=.env
# Mapbox public token (starts with pk.) for the map tab.
MAPBOX_PUBLIC_TOKEN=

# Stripe publishable key (test mode). Identifies the account to Stripe and can do nothing
# on its own: amounts are set by api-v2 against its secret key.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Native Google sign-in (#45): the WEB OAuth client id, which the ID token is audienced to.
# Not the Android client — that one is matched by package name and signing certificate.
GOOGLE_SERVER_CLIENT_ID=
